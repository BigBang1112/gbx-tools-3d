@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="panel left controls @(show ? "" : "closed")">
    <div class="opener" @onclick="ToggleShowAsync">
        @if (show)
        {
            <img src="icons/ui/keyboard_arrow_left.svg" width="32" height="32" />
        }
        else
        {
            <img src="icons/ui/keyboard_arrow_right.svg" width="32" height="32" />
        }
    </div>
    <div class="contents">
        <ReuButton CssClass="camera" Active="@(cameraType == ReplayCameraType.Cam2)" OnClick="() => SwitchCameraTypeAsync(ReplayCameraType.Cam2)" Tooltip="Replica of Cam2">
            <img src="icons/ui/videocam.svg" width="24" height="24" /><span>2</span>
        </ReuButton>
        <ReuButton CssClass="camera" Active="@(cameraType == ReplayCameraType.Orbital)" OnClick="() => SwitchCameraTypeAsync(ReplayCameraType.Orbital)" Tooltip="Orbiting camera">
            <img src="icons/ui/videocam.svg" width="24" height="24" /><span>O</span>
        </ReuButton>
        @*<ReuButton CssClass="camera" Active="@(cameraType == ReplayCameraType.Free)" OnClick="() => SwitchCameraTypeAsync(ReplayCameraType.Free)" Tooltip="Free camera">
            <img src="icons/ui/videocam.svg" width="24" height="24" /><span>F</span>
        </ReuButton>*@
        <ReuButton Active="@(collisionsEnabled)" OnClick="ToggleCollisionsAsync">Collisions</ReuButton>
    </div>
</div>
