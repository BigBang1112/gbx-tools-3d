<div class="gbx-upload" style="@(Height.HasValue ? $"height: {Height.Value}px;" : "") font-size: @(FontSize)%;">
    <ReuUploadArea OnUpload="OnUpload" MaxFileCount="1" Accept="@(Extensions is null ? null : string.Join(',', Extensions.Select(x => "." + x)))">
        <span>Drag &amp; Drop
            @if (Extensions?.Length > 0)
            {
                @for (var i = 0; i < Extensions.Length; i++)
                {
                    if (i > 0)
                    {
                        <span>/</span>
                    }
                    <span class="ext @(Extensions[i].EndsWith("Gbx", StringComparison.OrdinalIgnoreCase) ? "gbx" : "other")">@Extensions[i]</span>
                }
            }
            else
            {
                <span>any</span>
            }
            file here...</span>
        <span class="note">or click to upload</span>
    </ReuUploadArea>
</div>
