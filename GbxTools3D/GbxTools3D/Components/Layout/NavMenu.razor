<div class="site-navigation">
    @if (NoNav)
    {
        <div class="viewer-brand"><ReuContainer>3d.gbx.tools</ReuContainer></div>
    }
    else
    {
        <ReuNavMenu Brand="3d.gbx.tools" IsAbsolute="IsAbsolute">
            <ReuNavItem Name="Home" Href="" IconType="IconType.Home" NavLinkMatch="NavLinkMatch.All" />
            <ReuNavItem Name="View" Href="view" IconSrc="icons/ui/pageview.svg" />
            <ReuNavItem Name="Catalog" Href="catalog" IconSrc="icons/ui/menu_book.svg" />
            <ReuNavItem Name="Widgets" Href="widgets" IconSrc="icons/ui/widgets.svg" />
            <ReuNavItem Name="About" Href="about" IconType="IconType.Info" />
            <ReuNavItem Name="Blender Gbx Tools" Href="blender" IconSrc="icons/ui/blender.svg" IconOnly="true" />
            <ReuNavItem Name="Discord" Href="https://discord.gbx.tools" IconType="IconType.Discord"
                        IsNavLink="false" IconOnly="true" Title="Join the Discord server" />
            <ReuNavItem Name="Donate" Href="https://ko-fi.com/bigbang1112" IconSrc="icons/kofi.png"
                        IconOnly="true" Title="Donate" IsNavLink="false" />
            @if (IsAbsolute)
            {
                <div class="nav-item theme-toggle">
                    <ThemeToggle />
                </div>
            }
        </ReuNavMenu>
    }
</div>

@code {
    [Parameter]
    public bool IsAbsolute { get; set; }

    [SupplyParameterFromQuery(Name = "nonav")]
    private bool NoNav { get; set; }
}
